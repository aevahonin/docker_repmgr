# Copy to .env and fill in real values: cp .env.example .env
# All values are placeholders; the real .env is not committed.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# PostgreSQL paths
PGDATA=/var/lib/postgresql/data
PG_HBA_SOURCE=/etc/pg_hba.conf.template
PG_HBA_TARGET=/var/lib/postgresql/data/pg_hba.conf

# repmgr paths
REPMGR_CONF_TEMPLATE=/var/lib/postgresql/repmgr.conf.template
REPMGR_CONF=/var/lib/postgresql/repmgr.conf
REPMGR_LOG_FILE=/var/log/repmgr/repmgr.log

# repmgr identity
REPMGR_USER=repmgr
REPMGR_PASSWORD=CHANGE_ME
REPMGR_NODE_ROLE=primary
REPMGR_NODE_NAME=pg-node-1
REPMGR_NODE_ID=1
# Hostname of the primary (required for standby nodes)
REPMGR_PRIMARY_HOST=pg-node-1
REPMGR_UPSTREAM_NODE_ID=
REPMGR_PRIORITY=100

# Network
NODE_DOMAIN=pg-node-1
LISTEN_ADDRESSES=*

# Replication
MAX_WAL_SENDERS=10
MAX_REPLICATION_SLOTS=10
WAL_LEVEL=replica
WAL_KEEP_SIZE=1GB

# Container
CONTAINER_NAME=pg-node-1

# Docker network (must match the ipam subnet in docker-compose.yml)
DOCKER_SUBNET=172.28.0.0/16
NODE_IP=172.28.0.10